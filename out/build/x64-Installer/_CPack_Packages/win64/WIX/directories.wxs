<?xml version="1.0" encoding="UTF-8"?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:firewall="http://wixtoolset.org/schemas/v4/wxs/firewall" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
    <Fragment>
        <StandardDirectory Id="ProgramFiles6432Folder">
            <Directory Id="INSTALL_ROOT" Name="Deskflow">
                <Directory Id="CM_DP_docs" Name="docs"/>
                <Directory Id="CM_DP_plugins" Name="plugins">
                    <Directory Id="CM_DP_plugins.generic" Name="generic"/>
                    <Directory Id="CM_DP_plugins.iconengines" Name="iconengines"/>
                    <Directory Id="CM_DP_plugins.imageformats" Name="imageformats"/>
                    <Directory Id="CM_DP_plugins.networkinformation" Name="networkinformation"/>
                    <Directory Id="CM_DP_plugins.platforms" Name="platforms"/>
                    <Directory Id="CM_DP_plugins.styles" Name="styles"/>
                    <Directory Id="CM_DP_plugins.tls" Name="tls"/>
                </Directory>
                <Directory Id="CM_DP_translations" Name="translations"/>
            </Directory>
        </StandardDirectory>
        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="PROGRAM_MENU_FOLDER" Name="Deskflow"/>
        </StandardDirectory>
    </Fragment>
</Wix>